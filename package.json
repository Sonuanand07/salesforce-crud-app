{
  "name": "salesforce-crud-app",
  "version": "1.0.0",
  "description": "Salesforce CRUD web app using OAuth 2.0 (Authorization Code + PKCE) via an External Client App",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client ci && npm --prefix client run build",
    "test": "node --test \"test/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  }
}
