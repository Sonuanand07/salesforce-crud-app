# Consumer Key of your Salesforce External Client App (required)
SF_CLIENT_ID=
# Consumer Secret (leave empty only if "Require secret for Web Server Flow" is unchecked)
SF_CLIENT_SECRET=
# Dev orgs and production use login.salesforce.com. Sandboxes use https://test.salesforce.com or your My Domain URL.
SF_LOGIN_URL=https://login.salesforce.com
# Public URL of THIS app. Local: http://localhost:3000. Render: https://your-app.onrender.com
APP_URL=http://localhost:3000
PORT=3000
